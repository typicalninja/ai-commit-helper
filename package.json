    "keytar": "^7.9.0",
    "minimatch": "^10.2.1",
    "ora": "^9.0.0",
    "yalp-js": "^1.1.0",
    "yoctocolors": "^2.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "0.19.0-beta.5",
    "typescript": "^5.9.3"
